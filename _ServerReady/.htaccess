# Apache config for a single-page app (React Router with browser history).
# Any request that isn't a real file/folder falls back to index.html so
# deep links (e.g. /plot/1, /v/v14-sample-summary-header/plot/1) and page
# refreshes work instead of 404ing.
#
# No RewriteBase set on purpose: this app is built with relative asset
# paths so it can be deployed at the domain root OR a subfolder (e.g.
# example.com/resiyou/) without changes. Apache infers the base from this
# .htaccess file's own directory, which is correct for both cases. If your
# host's rewrite still misfires, uncomment the line below and set it to
# the exact subfolder path this was uploaded to:
# RewriteBase /resiyou/

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>
